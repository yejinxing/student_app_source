{
  "name": "student_app",
  "version": "1.0.1",
  "description": "学生信息处理工具 - 高效便捷的学生数据处理工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "test": "echo \"No tests configured\""
  },
  "build": {
    "appId": "com.student.app",
    "productName": "学生信息处理工具",
    "icon": "assets/icon.png",
    "files": [
      "main.js",
      "index.html",
      "icon.png",
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "artifactName": "StudentInfoTool-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "StudentInfoTool-Setup-${version}.${ext}",
      "differentialPackage": true
    },
    "portable": {
      "artifactName": "StudentInfoTool-Portable-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.education",
      "artifactName": "StudentInfoTool-${version}-macOS-${arch}.${ext}"
    },
    "dmg": {
      "artifactName": "StudentInfoTool-${version}-macOS-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "artifactName": "StudentInfoTool-${version}-Linux-${arch}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "yejinxing",
      "repo": "student_app_source",
      "releaseType": "release"
    }
  },
  "keywords": [
    "electron",
    "student",
    "excel",
    "word",
    "photo-renamer"
  ],
  "author": "yejinxing <yejinxing1728@qq.com>",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/yejinxing/student_app_source.git"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "docx": "^9.5.1",
    "electron-updater": "^6.7.3",
    "fs-extra": "^11.3.3",
    "js-yaml": "^4.1.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^2.16.105",
    "sharp": "^0.34.5",
    "xlsx": "^0.18.5"
  }
}
